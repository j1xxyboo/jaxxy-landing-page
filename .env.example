# Copy this file to .env.local and fill in the real values.
# .env.local is git-ignored — never commit a live API key.

# Picsart API key (Bearer token). Used only by the admin test dashboard.
VITE_PICSART_API_KEY=paat-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Passcode that unlocks /#/admin. Change it before deploying anywhere public.
VITE_ADMIN_PASSCODE=jaxxy-admin
